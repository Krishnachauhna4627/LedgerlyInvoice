# Copy to .env. Same settings as backend/.env, so both backends can share one database.
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
# Dates like "today" and "overdue" use this time zone.
app.appTimezone = 'Asia/Kolkata'

CORS_ORIGIN=http://localhost:4200,https://ledgerly-invoice.vercel.app

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ledgerly
DB_PASSWORD=change-me
DB_NAME=ledgerly

# Use the SAME value as backend/.env so logins work on both backends.
# Generate one with: php -r "echo bin2hex(random_bytes(48)), PHP_EOL;"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Outgoing email (forgot password). Leave SMTP_HOST empty in development to log emails to writable/logs.
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gogna <no-reply@example.com>
