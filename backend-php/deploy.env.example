# Copy to deploy.env (not committed) and fill in. Leave DEPLOY_HOST empty to only build a zip.
DEPLOY_HOST=            # e.g. 203.0.113.10 or myserver.com
DEPLOY_USER=            # SSH user
DEPLOY_PORT=22          # some shared hosts use 65002, 2222, ...
DEPLOY_PATH=            # folder on the server that holds spark, app/, public/  e.g. /home/user/ledgerly
REMOTE_PHP=php          # PHP 8.1+ binary on the server, e.g. /usr/local/bin/php81
RUN_MIGRATIONS=yes      # run 'php spark migrate --all' after upload
