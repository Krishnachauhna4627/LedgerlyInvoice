PORT=3000
CORS_ORIGIN=http://localhost:4200,https://ledgerly-invoice.vercel.app

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ledgerly
DB_PASSWORD=change-me
DB_NAME=ledgerly

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Outgoing email (forgot password). Leave SMTP_HOST empty in development to print emails to the console.
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gogna <no-reply@example.com>
